@startuml

skinparam nodesep 35
skinparam ranksep 35

skinparam backgroundColor #1E1E2E
skinparam defaultFontColor #FFFFFF
skinparam titleFontColor #FFFFFF

skinparam actorFontColor #FFFFFF
skinparam actorBorderColor #AFA9EC

skinparam usecaseArrowColor #FFFFFF
skinparam usecaseBorderColor #AFA9EC
skinparam usecaseBackgroundColor #534AB7

skinparam packageBorderColor #FFFFFF
skinparam packageFontColor #FFFFFF
skinparam packageBackgroundColor transparent

skinparam packageStyle rectangle
skinparam actorStyle awesome

title US003 - Use Case Diagram

' ===== Actors =====
actor "System User"        as SU
actor "External Program"   as EP << Secondary >>

' ===== System Boundary =====
rectangle "Shell System" {
    package "Session & Configuration" {
        usecase "Start Shell & REPL (US005)"           as REPL
        usecase "Load Configuration File (US020)"      as Config
        usecase "Manage Environment Variables (US012)" as Env
        usecase "Customize Prompt (US020)"             as Prompt
        usecase "Exit Shell (US005)"                   as Exit
    }

    package "Parsing & Processing" {
        usecase "Tokenize Raw Input (US006)"           as Token
        usecase "Parse Syntax (US007)"                 as Parse
        usecase "Handle Quoting & Escape (US008)"      as Quote
        usecase "Perform Shell Expansions (US009)"     as Expand
    }

    package "Command Execution" {
        usecase "Execute Command Line (US005)"          as Exec
        usecase "Run Built-in Command (US011)"          as Builtin
        usecase "Run External Program (US010)"          as External
        usecase "Compose Pipelines (US014)"             as Pipe
        usecase "Sequence & Logical Execution (US015)"  as Seq
    }

    package "I/O Redirection" {
        usecase "Redirect Streams (US013)"             as Redir
    }

    package "Job Control & Signals" {
        usecase "Manage Background Jobs (US016)"       as Jobs
        usecase "Handle System Signals (US017)"        as Signals
    }

    package "Interactive Line Interface" {
        usecase "Manage Command History (US018)"       as Hist
        usecase "Edit Line & Tab Complete (US019)"     as Edit
    }
}

' ===== Primary Actor Associations =====
SU -- REPL
SU -- Config
SU -- Env
SU -- Prompt
SU -- Exit
SU -- Exec
SU -- Jobs
SU -- Signals
SU -- Hist
SU -- Edit

' ===== Execution Dependencies & Flows =====
REPL .> Token : <<include>>
Token .> Parse : <<include>>
Parse .> Quote : <<include>>
Parse .> Expand : <<extend>>

Exec <|-- Builtin
Exec <|-- External
Exec <|-- Pipe
Exec <|-- Seq

Exec <.. Redir : <<extend>>

' ===== Secondary Actor Associations =====
External -- EP
@enduml